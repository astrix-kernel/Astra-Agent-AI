# === LLM Configuration ===
# Pilih salah satu:
# - Ollama:      http://localhost:11434/v1/chat/completions
# - LM Studio:   http://localhost:1234/v1/chat/completions
# - OpenRouter:  https://openrouter.ai/api/v1/chat/completions
# - OmniRoute:   http://localhost:20128/v1/chat/completions
LLM_URL=http://localhost:11434/v1/chat/completions

# Kosongin kalau mau provider pilih default (recommended buat portable)
LLM_MODEL=
# Kalau provider butuh model spesifik, isi di sini:
# LLM_MODEL=llama3
# LLM_MODEL=gpt-4
# LLM_MODEL=mistral
LLM_API_KEY=sk-your-omniroute-key-here

# === Workspace ===
ASTRIX_WORKSPACE=/home/yourname/projects

# === Server ===
ASTRIX_PORT=8765
ASTRIX_HOST=0.0.0.0
